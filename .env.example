# No keys required for the local deterministic demo. Copy to .env only when configuring.
KINFOLD_AI_MODE=demo
# Use gemini or deepagents to enable a real optional model call on investigation.
# The same key enables AI claim extraction for uploaded records. Each live response is saved to
# data/ai_cache/ (KINFOLD_AI_CACHE overrides) and is replayed, re-verified, when no key is set.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Set a currently supported model ID explicitly; there is no guessed default.
# GEMINI_MODEL=gemini-3.5-flash   (verified working 2026-11-14; gemini-3.8-flash was overloaded)

KINFOLD_STORAGE=json
# KINFOLD_DATA_DIR=data/runtime
# Use mongodb only with optional dependencies and an explicitly configured URI.
# MONGODB_URI=
# MONGODB_DATABASE=kinfold

# Optional CLI-only devnet RPC override. Genesis hash must match devnet.
# SOLANA_DEVNET_RPC=https://api.devnet.solana.com
